# Copy to .env (ignored by git). Everything runs locally without this file.
# Optional LLM tutor: explains results and comments on a single mouth photo; never scores.
COACH_LLM_PROVIDER=none            # none | openai | kimi
COACH_LLM_API_KEY=
# OpenAI (default choice): GPT-6 Luna handles both text and mouth photos.
COACH_LLM_BASE_URL=https://api.openai.com/v1
COACH_LLM_MODEL=gpt-6-luna
COACH_LLM_VISION_MODEL=gpt-6-luna
# Kimi/Moonshot alternative:
#COACH_LLM_BASE_URL=https://api.moonshot.ai/v1
#COACH_LLM_MODEL=kimi-k2.7-code-highspeed   # text (~2 s)
#COACH_LLM_VISION_MODEL=kimi-k2.6           # mouth photos (reads images; slower)

# Phones on the network must pair once. Empty = a new 6-digit code is printed in the API log on each
# start (`make api-lan`); set a fixed code if you prefer. Loopback clients never need a token.
COACH_PAIRING_CODE=
# `fake` runs the API without the 1.2 GB model (CI, demos); results are tagged fake-recognizer@ci.
COACH_RECOGNIZER=wav2vec2
# JSON logs (one object per line). Set false for plain text while debugging.
COACH_LOG_JSON=true
