          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Progress",
        "tags": ["progress"]
      }
    },
    "/api/v1/runs/{run_id}": {
      "get": {
