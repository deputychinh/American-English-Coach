      }
    },
    "/api/v1/runs/{run_id}/dispute": {
      "post": {
        "description": "Learner says \"T\u00f4i n\u00f3i \u0111\u00fang m\u00e0\"; kept as false-alarm evidence.",
        "operationId": "dispute_api_v1_runs__run_id__dispute_post",
        "parameters": [
          {
            "in": "path",
