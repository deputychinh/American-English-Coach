    "/api/v1/tutor/explain": {
      "post": {
        "description": "Explain a run's verdicts in plain Vietnamese (the model does not score).",
        "operationId": "explain_api_v1_tutor_explain_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
