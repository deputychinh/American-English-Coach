            },
            "title": "Groups",
            "type": "array"
          },
          "transitions": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Transitions",
            "type": "object"
          }
        },
        "required": ["features", "groups", "calibration", "transitions", "confidence_labels"],
        "title": "VisemeContent",
        "type": "object"
      },
      "VisemeGroup": {
        "description": "Visible mouth-shape group (plan \u00a72.1). Sounds outside these are audio-only.",
        "enum": ["V1", "V2", "V3", "V4", "V5", "V6", "V7", "V8", "V9", "V10", "V11", "V12"],
        "title": "VisemeGroup",
        "type": "string"
      },
      "VisemeTargetCard": {
        "description": "Target ranges and copy for the mouth mirror.",
        "properties": {
          "common_error_vi": {
            "title": "Common Error Vi",
            "type": "string"
          },
          "confidence": {
            "title": "Confidence",
            "type": "string"
          },
          "group": {
            "$ref": "#/components/schemas/VisemeGroup"
          },
          "hint_vi": {
            "title": "Hint Vi",
            "type": "string"
          },
          "hold_ms": {
            "title": "Hold Ms",
            "type": "integer"
          },
          "name_vi": {
            "title": "Name Vi",
            "type": "string"
          },
          "sounds": {
            "items": {
              "type": "string"
            },
            "title": "Sounds",
            "type": "array"
          },
          "targets": {
            "additionalProperties": {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            "title": "Targets",
            "type": "object"
          }
        },
        "required": [
          "group",
          "name_vi",
          "sounds",
          "targets",
          "hold_ms",
          "hint_vi",
          "common_error_vi",
          "confidence"
        ],
        "title": "VisemeTargetCard",
        "type": "object"
      },
      "VisualVerdict": {
        "description": "Outcome of comparing the learner's mouth features with the target of a sound.",
        "enum": ["ok", "off", "unavailable"],
        "title": "VisualVerdict",
        "type": "string"
      },
      "WordResult": {
        "description": "A prompt word with its reference IPA and per-phone verdicts.",
        "properties": {
          "ipa": {
            "title": "Ipa",
            "type": "string"
          },
          "phones": {
            "items": {
              "$ref": "#/components/schemas/PhoneResult"
            },
            "title": "Phones",
            "type": "array"
          },
          "word": {
            "title": "Word",
            "type": "string"
          }
        },
        "required": ["word", "ipa", "phones"],
        "title": "WordResult",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "American English Coach API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/assess": {
      "post": {
        "description": "Score one recording of `text`; mouth frames are optional and never contain video.",
        "operationId": "assess_api_v1_assess_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_assess_api_v1_assess_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssessmentResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Assess",
        "tags": ["assessment"]
      }
    },
    "/api/v1/audio": {
      "get": {
        "description": "WAV of the prompt spoken by the local American voice (cached).",
        "operationId": "audio_api_v1_audio_get",
        "parameters": [
          {
            "in": "query",
            "name": "text",
            "required": true,
            "schema": {
              "maxLength": 200,
              "minLength": 1,
              "title": "Text",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Audio",
        "tags": ["audio"]
      }
    },
    "/api/v1/calibration": {
      "get": {
        "description": "Stored mouth calibration, if any.",
        "operationId": "calibration_api_v1_calibration_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/CalibrationPayload"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "title": "Response Calibration Api V1 Calibration Get"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Calibration",
        "tags": ["progress"]
      },
      "put": {
        "description": "Replace the mouth calibration.",
        "operationId": "save_calibration_api_v1_calibration_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CalibrationPayload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Save Calibration",
        "tags": ["progress"]
      }
    },
    "/api/v1/content/errors": {
      "get": {
        "description": "Error catalogue.",
        "operationId": "errors_api_v1_content_errors_get",
        "responses": {
          "200": {
