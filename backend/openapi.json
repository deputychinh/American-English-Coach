    },
    "/api/v1/tutor/mouth": {
      "post": {
        "description": "Comment on one JPEG of the learner's mouth (sent only when the learner asks).",
        "operationId": "mouth_api_v1_tutor_mouth_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
