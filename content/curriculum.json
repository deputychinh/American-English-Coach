      "title_vi": "Nền tảng",
      "title_en": "Foundation",
      "goal_vi": "Nghe ra và phát được từng âm trong từ, không rụng âm cuối, biết âm tiết nào mạnh.",
      "units": [
        {
          "id": "u01",
          "title_vi": "Âm tiết và trọng âm từ hai âm tiết",
          "title_en": "Syllables and two-syllable stress",
          "goal_vi": "Đếm được âm tiết và làm âm tiết mạnh dài hơn, to hơn, cao hơn.",
          "vn_error_vi": "Mỗi âm tiết tiếng Việt có thanh riêng nên các âm tiết hay được đọc đều nhau; tiếng Anh cần một âm tiết nổi hẳn.",
