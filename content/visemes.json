  "sounds_extra": {
    "AY": {
      "transition_vi": "Bắt đầu hàm mở rộng (/a/), kết thúc môi kéo ngang hàm khép (/ɪ/)."
    },
    "AW": {
      "transition_vi": "Bắt đầu hàm mở rộng (/a/), kết thúc môi chu tròn (/ʊ/)."
    },
    "OY": {
      "transition_vi": "Bắt đầu môi tròn (/ɔ/), kết thúc môi kéo ngang (/ɪ/)."
    },
    "EY": {
      "transition_vi": "Bắt đầu hàm hé (/e/), kết thúc môi kéo ngang hơn (/ɪ/)."
    },
    "OW": {
      "transition_vi": "Bắt đầu môi tròn nhẹ (/o/), kết thúc chu tròn hơn (/ʊ/)."
    },
    "ER": {
      "transition_vi": "Giữ môi tròn nhẹ ổn định; âm /r/ Mỹ không có cú chạm lưỡi."
